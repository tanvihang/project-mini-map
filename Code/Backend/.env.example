# =============================================================================
# Mini-Map Backend — environment template.
#   1. Copy to .env:            cp .env.example .env
#   2. Fill in real values.     .env is gitignored — NEVER commit real secrets.
# Every key below is read by app/core/config.py (pydantic-settings).
# =============================================================================

# --- Runtime ---------------------------------------------------------------
APP_ENV=local                 # local | staging | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# --- Google Cloud / Vertex AI ----------------------------------------------
# These three are the ADK equivalent of genai.Client(vertexai=True, project=...).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Optional: path to a service-account key. Leave BLANK to use ADC
# (`gcloud auth application-default login`) — the recommended local path.
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini model alias. Use a current alias (e.g. gemini-2.5-flash); do NOT pin
# a minor/build version — let Google roll the alias forward.
GEMINI_MODEL=gemini-2.5-flash

# --- MongoDB Atlas ----------------------------------------------------------
# Local Docker:  mongodb://localhost:27017
# Atlas:         mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=minimap

# --- External APIs ----------------------------------------------------------
VOYAGE_API_KEY=               # embeddings (issued from the Atlas dashboard)
OPENWEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=
FX_API_KEY=                   # Fixer.io — drives MultiCurrency conversion

# --- Gateway ----------------------------------------------------------------
# Optional shared secret the single public gateway checks on each request.
# Leave BLANK to disable the check during local development.
GATEWAY_API_KEY=
